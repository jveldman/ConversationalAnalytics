# Conversational Analytics - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# Cube.js Configuration
# ============================================
CUBEJS_API_SECRET=your_cube_api_secret_here
CUBEJS_CACHE_AND_QUEUE_DRIVER=memory
CUBEJS_DB_TYPE=duckdb
CUBEJS_DB_URL=md:pocca
CUBEJS_DB_USER=your_email@example.com
CUBEJS_QUERY_TIMEOUT=120

# Cube API URL (use localhost for dev, production URL for deployed Cube)
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
# CUBE_API_URL=https://prod-cubelayer.onrender.com/cubejs-api/v1

# MotherDuck Configuration
MOTHERDUCK_DB=pocca
MOTHERDUCK_TOKEN=your_motherduck_token_here
CUBEJS_DB_DUCKDB_MOTHERDUCK_TOKEN=your_motherduck_token_here

# ============================================
# LLM Configuration
# ============================================
LLM_PROVIDER=mistral
MISTRAL_API_KEY=your_mistral_api_key_here

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
PORT=4000

# DuckDB Configuration
DUCKDB_PATH=data/duckdb/warehouse.duckdb
